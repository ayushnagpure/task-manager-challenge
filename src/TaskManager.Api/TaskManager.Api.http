@host = http://localhost:5157

### Health check (expect 200 "Healthy")
GET {{host}}/health

### Unknown route (expect 404 application/problem+json with traceId)
GET {{host}}/nope
Accept: application/json

### CORS preflight from the UI origin (expect Access-Control-Allow-Origin: http://localhost:5173)
OPTIONS {{host}}/health
Origin: http://localhost:5173
Access-Control-Request-Method: GET

### CORS preflight from an unknown origin (expect NO Access-Control-Allow-Origin header)
OPTIONS {{host}}/health
Origin: http://evil.test
Access-Control-Request-Method: GET

############ Tasks: create ############

### Create a task (expect 201, Location: /api/tasks/{id}, body with rowVersion)
# @name createTask
POST {{host}}/api/tasks
Content-Type: application/json

{
  "title": "Try the API by hand",
  "description": "Created from TaskManager.Api.http",
  "priority": "High",
  "assignedTo": "Alice"
}

### Get the task just created (expect 200, same body)
GET {{host}}/api/tasks/{{createTask.response.body.$.id}}

### Status omitted + lowercase priority (expect 201, status "Todo", priority "Critical")
POST {{host}}/api/tasks
Content-Type: application/json

{ "title": "Defaults", "priority": "critical" }

### Validation: blank title + unknown priority (expect 400, errors.Title and errors.Priority)
POST {{host}}/api/tasks
Content-Type: application/json

{ "title": "   ", "priority": "Urgent" }

### Validation: unknown status (expect 400, errors.Status lists Todo, InProgress, Done)
POST {{host}}/api/tasks
Content-Type: application/json

{ "title": "Bad status", "status": "Blocked", "priority": "Low" }

### Validation: numeric priority (expect 400, errors["$.priority"]: "The input was not valid.")
POST {{host}}/api/tasks
Content-Type: application/json

{ "title": "Numeric", "priority": 2 }

### Malformed JSON (expect 400, no parser or type details in the body)
POST {{host}}/api/tasks
Content-Type: application/json

{ "title":

### Validation keys are camelCase like the body (expect errors.title, errors.priority, errors.assignedTo)
POST {{host}}/api/tasks
Content-Type: application/json

{ "title": "", "priority": "Urgent", "assignedTo": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }

############ Tasks: list ############

### All active tasks, seeded DB (expect 12; order ids 12, 8, 4, 11, 7, 3, 10, 6, 2, 9, 5, 1)
GET {{host}}/api/tasks

### Filter by status (expect 4 Done tasks: ids 12, 11, 10, 9)
GET {{host}}/api/tasks?status=Done

### Filter by priority, case-insensitive (expect 3 Critical tasks: ids 12, 8, 4)
GET {{host}}/api/tasks?priority=critical

### Both filters (expect 1 task: id 3)
GET {{host}}/api/tasks?status=Todo&priority=High

### Soft-deleted rows excluded (seed id 14 is InProgress/High but deleted; expect only id 7)
GET {{host}}/api/tasks?status=InProgress&priority=High

### Empty filter value = no filter (expect all 12)
GET {{host}}/api/tasks?status=

### Invalid filters (expect 400, errors.status and errors.priority list the allowed values)
GET {{host}}/api/tasks?status=Blocked&priority=Urgent

### Numeric priority (expect 400, errors.priority)
GET {{host}}/api/tasks?priority=2

############ Tasks: update (PUT full edit, optimistic concurrency) ############
# Run these in order. The GET captures task 1's current rowVersion.

### 1. Read task 1 and remember its rowVersion
# @name task1
GET {{host}}/api/tasks/1

### 2. PUT with that rowVersion (expect 200, new values, NEW rowVersion, later modifiedDate, same createdDate)
PUT {{host}}/api/tasks/1
Content-Type: application/json

{
  "title": "Archive old project files (edited)",
  "description": "Edited from TaskManager.Api.http",
  "status": "InProgress",
  "priority": "Medium",
  "assignedTo": "Bob",
  "rowVersion": "{{task1.response.body.$.rowVersion}}"
}

### 3. Run the SAME PUT again: its rowVersion is now stale (expect 409 Conflict)
PUT {{host}}/api/tasks/1
Content-Type: application/json

{
  "title": "A second writer",
  "status": "Done",
  "priority": "Low",
  "rowVersion": "{{task1.response.body.$.rowVersion}}"
}

### Missing rowVersion (expect 400, errors.rowVersion: "RowVersion is required.")
PUT {{host}}/api/tasks/1
Content-Type: application/json

{ "title": "x", "status": "Todo", "priority": "Low" }

### Malformed rowVersion (expect 400, errors.rowVersion: "RowVersion must be the base64 value returned by the API.")
PUT {{host}}/api/tasks/1
Content-Type: application/json

{ "title": "x", "status": "Todo", "priority": "Low", "rowVersion": "bad" }

### Soft-deleted task (expect 404)
PUT {{host}}/api/tasks/13
Content-Type: application/json

{ "title": "x", "status": "Todo", "priority": "Low", "rowVersion": "AAAAAAAAB9E=" }

############ Tasks: change status (PATCH, last write wins) ############

### Change status (expect 200, status "Done", NEW rowVersion; no rowVersion needed)
PATCH {{host}}/api/tasks/2/status
Content-Type: application/json

{ "status": "Done" }

### Same status again (expect 200, nothing changed: same rowVersion and modifiedDate)
PATCH {{host}}/api/tasks/2/status
Content-Type: application/json

{ "status": "Done" }

### Invalid status (expect 400, errors.status lists Todo, InProgress, Done)
PATCH {{host}}/api/tasks/2/status
Content-Type: application/json

{ "status": "Blocked" }

### Soft-deleted task (expect 404)
PATCH {{host}}/api/tasks/13/status
Content-Type: application/json

{ "status": "Done" }

############ Tasks: summary (raw SQL) ############

### Counts by status and priority (expect 200, [{ "status", "priority", "count" }],
### ordered Todo, InProgress, Done then Critical, High, Medium, Low; deleted tasks excluded)
GET {{host}}/api/tasks/summary

############ Tasks: soft delete ############
# Run in order. Task 5 is a seeded active task.

### Delete task 5 (expect 204 No Content, empty body)
DELETE {{host}}/api/tasks/5

### Get it (expect 404, same shape as an unknown id)
GET {{host}}/api/tasks/5

### Delete it again (expect 404)
DELETE {{host}}/api/tasks/5

### List (expect 11 tasks, id 5 no longer present)
GET {{host}}/api/tasks

### Status change on the deleted task (expect 404)
PATCH {{host}}/api/tasks/5/status
Content-Type: application/json

{ "status": "Done" }

### Unknown id (expect 404 "Task with id '999999' was not found.")
DELETE {{host}}/api/tasks/999999

### id = 0 (expect 404 ProblemDetails)
DELETE {{host}}/api/tasks/0

############ Tasks: get by id ############

### Seeded active task (expect 200)
GET {{host}}/api/tasks/1

### Seeded soft-deleted task (expect 404, same shape as unknown id)
GET {{host}}/api/tasks/13

### Unknown id (expect 404 "Task with id '999999' was not found.")
GET {{host}}/api/tasks/999999

### id = 0 (expect 404 ProblemDetails; route constraint is {id:int:min(1)})
GET {{host}}/api/tasks/0
